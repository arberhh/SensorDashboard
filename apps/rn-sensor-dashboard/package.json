{
  "name": "SensorDashboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "oxlint --deny-warnings . && eslint . --max-warnings=0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "ts:check": "tsc --noEmit",
    "deadcode": "knip",
    "core:types": "tsc -p ../../packages/sensor-core",
    "start": "react-native start",
    "test": "jest",
    "generate:data": "node scripts/genSensorData.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@shopify/flash-list": "^2.3.2",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "sensor-core": "file:../../packages/sensor-core"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-native": "^5.0.0",
    "hermes-eslint": "^0.37.0",
    "jest": "^29.6.3",
    "knip": "^6.35.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "prettier": "2.8.8",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "eslint-plugin-ft-flow": "^3.0.11"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
